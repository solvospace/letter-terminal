{
    "name": "letter-terminal",
    "license": "AGPL-3.0-or-later",
    "private": true,
    "scripts": {
        "dev": "concurrently \"turbo run dev --concurrency=10\" \"wait-on http://localhost:3010 && open http://localhost:3010\"",
        "clean": "turbo run clean && rm -rf .turbo && rm -rf .next && rm -rf node_modules && rm -rf dist",
        "build": "turbo run build",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "check-types": "turbo run check-types"
    },
    "devDependencies": {
        "concurrently": "^10.0.5",
        "turbo": "^2.10.12",
        "wait-on": "^9.1.0",
        "@types/node": "24.1.0",
        "typescript": "6.0.3",
        "eslint": "9.39.1"
    },
    "packageManager": "pnpm@12.11.2",
    "engines": {
        "node": "24.20.0"
    }
}