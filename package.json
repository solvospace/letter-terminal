{
    "name": "letter-terminal",
    "license": "AGPL-3.0-or-later",
    "private": true,
    "scripts": {
        "dev": "turbo run dev & sleep 3 && open http://localhost:3010",
        "clean": "turbo run clean && rm -rf .turbo .next node_modules dist apps/backend/bin apps/backend/tmp",
        "install:all": "pnpm install --frozen-lockfile && cd apps/backend && go mod download",
        "clean:go": "cd apps/backend && go clean -cache -testcache -modcache",
        "build": "turbo run build",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "check-types": "turbo run check-types"
    },
    "devDependencies": {
        "turbo": "catalog:",
        "@types/node": "catalog:",
        "typescript": "catalog:",
        "eslint": "catalog:"
    },
    "engines": {
        "node": ">=24.22.3"
    },
    "packageManager": "pnpm@12.21.0"
}